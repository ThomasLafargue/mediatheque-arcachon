4635-4bRel.d9.50 EUR  a(Abes)271931663#1a9782408046354  a20230904j20230906c  u0frey50      ba0 afre  aFR  aa       000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLes énergiesbTexte impriméfEmmanuelle FiguerasgMikael Moune  aToulouse Cedex 9cEditions MilandDL 2023#0aToulouse Cedex 9cEditions MilandDL 2023  a1 vol. (37 p.)cill. en coul.d21 cm x 21 cmf340 g2 aMes p'tites questions Nature  aDisponible  aLes énergies, un titre pour comprendre un sujet d'actualité à l'heure du réchauffement climatique. Et s'y retrouver dans tous les débats qui entourent les techniques d'exploitation des sources énergie utilisées aujourd'hui et la consommation que l'on en fait au quotidien. Un documentaire sur les différentes sources d'énergie utilisées par l'homme Un ouvrage en 40 pages, qui répond de façon simple et claire à 16 questions essentielles que les petits curieux se posent sur les énergies - les "fossiles" ou les "renouvelables" -, leurs utilisations et les implications que ces utilisations peuvent avoir pour notre planète. Depuis quand on utilise de l'énergie ? C'est quoi, la source d'énergie la plus utilisée dans le monde ? C'est quoi, les énergies fossiles ? C'est quoi, les énergies renouvelables ? Quelles sont les énergies les plus polluantes ? Les moins polluantes ? C'est dangereux, le nucléaire ? Pourquoi on parle de crise énergétique ? Quelles sont les énergies du futur ? ... "Mes p'tites questions" : une collection qui répond simplement aux questions des 7-9 ans Une collection documentaire tout illustrée et une approche renouvelée des grandes thématiques documentaires, qu'elles soient classiques ou au plus près du quotidien des enfants. Les mille et une questions des enfants telles qu'ils se les posent sur le monde qui les entoure, et, surtout, des réponses claires et simples, toujours à leur hauteur.  aÀ partir de 7 ans  b9782408046354 0tMes p'tites questions Naturex2800-6143  311932761aRessources énergétiques2rameau  312042408aOuvrages pour la jeunesse2rameau  a621.042 083v23  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE700c22ORB-Code  aDocumentairesc22ORB-Label  aJE706c32ORB-Code  aNature - Plantes dès 6 ansc32ORB-Label 1aFiguerasbEmmanuelleoISNI00000000065290963125251384070 1aMounebMikaeloISNI00000004651538763177385704440 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20230908gAFNOR 0aFRbAbesc20250507gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782408046354-475x500-1.jpg  a101343nam# 2200421#i 450 orb9782413091325  a978-2-413-09132-5bRel.d32.50 EUR#1a9782413091325  aj20250812m  u0frey50      ba0 afre  aFR  ay###t   000yy  ar  601aibxxxeabbxb2e  601ctxtcsti2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aNeandertal - IntégralebTexte impriméfEmmanuel Roudier  aPariscDelcourtdDL 2025#0aPariscDelcourtdDL 2025  a1 vol. (168 p.)d32 cm x 23 cmf1245 g2 aLong Métrage  aDisponible  b9782413091325 0tLong Métrage 0tNéandertalvIntégrale  a741.56v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD300c22ORB-Code  aBD tout publicc22ORB-Label  aBD306c32ORB-Code  aHistoriquec32ORB-Label 1aRoudierbEmmanuelf1971-....oISNI00000000551561853144452554070 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782413091325-475x500-1.jpg  a103500cam# 2200397#i 450 orb9782709677424  a978-2-7096-7742-4bBr.d20.90 EUR#1a9782709677424  a20260504j20260506m  u0frey50      ba0 afre  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLes solitudes de Petite RivièrebTexte impriméfKalindi Ramphul  aPariscJean-Claude LattèsdDL 2026#0aPariscJean-Claude LattèsdDL 2026  a1 vol. (324 p.)d20 cm x 13 cmf304 g  aDisponible  aEn quittant son Andalousie natale, Soledad, romancière taciturne, croyait avoir laissé derrière elle l'essentiel : le souvenir de sa mère Sheela, cantatrice baroque, et... sa malédiction. Elle aspire désormais à la tranquilité à l'Ile Maurice. Jusqu'à ce que l'un de ses lecteurs, le jeune Sanjay, la supplie de lui raconter son histoire. Sa véritable histoire. Alors Soledad se confie : son enfance au bazar de Petite Rivière, la passion tempétueuse de ses parents, les airs de Puccini, ses soeurs tyranniques... A mesure du récit, une autre histoire se révèle - plus intime, plus secrète aussi. Des toits en taule de Petite Rivière aux plus beaux théâtres sévillans, Kalindi Ramphul vous embarque dans une fresque vibrante où l'art et le désir traversent le temps et les océans. Un roman virevoltant sur les héritages silencieux et les mots comme refuge contre l'oubli. " Entre les théâtres sévillans et les lagons mauriciens, Kalindi Ramphul offre un troisième roman vibrant sur l'héritage et le désir, explorant avec une grande sensibilité la manière dont l'art nous sauve de l'oubli". L'éclaireur Fnac " Chaque livre de Kalindi Ramphul relie des territoires rarement associés, comme pour explorer de nouvelles trajectoires de vie. Une manière de partager son évidente curiosité tout en ouvrant ses lecteur-ices à l'aventure. " Marie Claire " Avec ce troisième roman, Kalindi Ramphul confirme son talent et nous propose une histoire qui nous entraîne dans le temps (tout commence dans les années 1980) et l'espace (l'intrigue se déroule entre l'Espagne et l'île Maurice). " ELLE " Si le ton de Kalindi Ramphul est moins burlesque que dans ses deux précédents livres, sa fantaisie doucement désenchantée n'a rien à envier à celle d'Olivier Bourdeaut dans "En attendant Bojangles" . Pour nous raconter ce qu'est une famille, elle convoque des lumières, des odeurs, des musiques, des étoffes, des rires aux larmes et des peines immenses. Sheela, la soprano qui se prenait pour Madame Butterfly, continuera long temps de chanter dans nos mémoires. " ELLE  b9782709677424 0tLes solitudes de Petite Rivièreuhttps://www.base-orb.fr/product/9791035424152/show/y9791035424152 0tLes solitudes de Petite Rivière.uhttps://www.base-orb.fr/product/9782709678070/show/y9782709678070  a843v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT100c22ORB-Code  aLittérature françaisec22ORB-Label 1aRamphulbKalindi4070 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782709677424-475x500-1.jpg  a102116cam# 2200505#i 450 orb9782384966646  a978-2-38496-664-6bBr.d7.20 EUR#1a9782384966646  a20260617j20260617a  u0frey50      ba1 afrecjpn  aFR  aa   t   000yy  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aHoney Lemon SodabTexte impriméfMayu Muratagtraduit du japonais par Manon DebiennegStudio Charon  aVanves cedexcNobi NobidDL 2026#0aVanves cedexcNobi NobidDL 2026  a1 vol. (176 p.)cill.d18 cm x 11 cmf150 g2 aShôjo  aDisponible  aUka Ishimori et Kai Miura filent le parfait amour depuis plus d'un an. La classe verte des terminales approche à grands pas ! S'agissant du dernier événement scolaire de ses années lycée, Uka attend ce séjour avec impatience... Mais voilà que les problèmes s'enchaînent juste avant le départ ! Le voyage se passera-t-il comme prévu ? Cinq nuits et quatre jours auprès de la personne qu'on aime, que peut-on rêver de mieux ?  b9782384966646 0tShôjo 0tHoney Lemon Soda T15.uhttps://www.base-orb.fr/product/9782384966653/show/y9782384966653 0tHoney Lemon Soda 0tHoney Lemon Sodav15  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-02c42ORB-Code  aShojo (fille)c42ORB-Label 1aMuratabMayu4070 1aDebiennebManonoISNI00000004596633193170584224730  aStudio Charon3165476914010 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782384966646-475x500-1.jpg  a102015cam# 2200493#i 450 orb9782505144038  a978-2-505-14403-8bBr.d8.10 EUR#1a9782505144038  a20260521j20260522m  u0frey50      ba1 afreceng  aFR  aa   t   000yy  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLa voie du tablierbTexte impriméfKousuke Oonogtraduit de l'anglais par Rodolphe GicquelgEric Montésinos  aPariscKanadDL 2026#0aPariscKanadDL 2026  a1 vol. (160 p.)cill.d18 cm x 12 cmf130 g2 aBig Kana Life  aDisponible  aNe sous-estimez jamais un homme au foyer ! Tatsu doit accompagner son beau-père chez le vétérinaire pour faire vacciner son chien. Mais ce canidé a un drôle de défaut : il se met à trembler de tout son corps rien qu'en entendant les mots "vaccin", "piqûres" et "piquer"... Avec tous ces "adversaires" qui se succèdent, même le plus coriace des hommes au foyer en bave ! Voici le seizième volume de ce manga comique, qui raconte la vie d'un ancien yakuza à la maison !  b9782505144038 0tBig Kana Life 0tGokushufudo 0tLa voie du tablierv16  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-05c42ORB-Code  aSeinen (homme)c42ORB-Label 1aOonobKousuke4070 1aGicquelbRodolphe4730 1aMontésinosbEric4010 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782505144038-475x500-1.jpg  a102915cam# 2200481#i 450 orb9782330221492  a978-2-330-22149-2bBr.d23.80 EUR  a(Abes)297653164#1a9782330221492  a20260504j20260506m  u0frey50      ba1 afreceng  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLa sainte patronne des menteusesbTexte impriméfAnn Patchettgtraduit de l'anglais par Hélène Frappat  aArles cedexcActes Sud EditionsdDL 2026#0aArles cedexcActes Sud EditionsdDL 2026  a1 vol. (480 p.)d23 cm x 13 cmf560 g  aDisponible  aRose a tout laissé derrière elle. Elle a fui la Californie et son mari sans rien lui révéler de sa grossesse, et se rend dans le Kentucky, à Sainte-Elisabeth, un refuge pour femmes enceintes souhaitant accoucher dans l'anonymat. Dans l'effervescence silencieuse de cette communauté, Rose se lie d'amitié avec soeur Evangeline et Son, le gardien du domaine. Alors que la règle impose d'abandonner son bébé pour reprendre le cours d'une vie normale, Rose fait finalement un choix impensable : elle décide de garder sa fille, Cecilia, et d'épouser Son pour s'ancrer définitivement à Sainte-Elisabeth, tout en cachant à son nouveau mari les raisons réelles de sa fuite. Mais peut-on bâtir une existence entière sur une imposture ? Des années plus tard, c'est à travers les yeux de Cecilia que se dévoilent les secrets d'une mère prête à se dérober au premier signe de menace. Premier roman d'Ann Patchett, cette saga bouleversante explore avec grâce la maternité, le poids des silences et la force des liens que l'on choisit de tisser au mépris des conventions.  b9782330221492 0tLa sainte patronne des menteusesuhttps://www.base-orb.fr/product/9782330221614/show/y9782330221614 0tLa sainte patronne des menteusesuhttps://www.base-orb.fr/product/9782330221638/show/y9782330221638 0tThe Patron Saint of Liars  311982432aRoman américain2rameau  a820v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT500c22ORB-Code  aLittérature étrangèrec22ORB-Label  aLIT511c32ORB-Code  aLittérature anglo-saxonnec32ORB-Label 1aPatchettbAnnf1963-....oISNI000000008235884X3144156854070 1aFrappatbHélènef1969-....oISNI00000001160762783144393414730 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20260623gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782330221492-475x500-1.jpg  a102248cam# 2200421#i 450 orb9782824625249  a978-2-8246-2524-9bBr.d18.90 EUR#1a9782824625249  a20260518j20260520m  u0frey50      ba0 afre  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aMoi, Anaïs BergbTexte impriméfDiane McEvoy  aGrainvillecCity EditionsdDL 2026#0aGrainvillecCity EditionsdDL 2026  a1 vol. (270 p.)d22 cm x 14 cmf430 g  aDisponible  aAnaïs Berg est une petite amie attentionnée, une voisine souriante et une professeure respectée. Elle mène à Liverpool une vie tranquille. Un jour, dans une foule, elle aperçoit une silhouette qui fait douloureusement écho à un passé bien enfoui. Sans doute du surmenage. Puis elle a la sensation d'être suivie. Elle se raisonne, mais sort de moins en moins de chez elle. Sa maison. Son cocon. Où ses vêtements changent de place. Où une playlist se lance toute seule. Cherche-t-on à la rendre folle ? Mais quand les menaces se font directes, Anaïs comprend : quelqu'un sait, et le piège est en train de se refermer doucement sur elle.  aVersaillaise longtemps expatriée à Liverpool, vit actuellement à Bordeaux. Passionnée de musique, elle écrit depuis toujours que ce soit pour différents médias, pour la publicité ou pour son propre plaisir. Moi, Anaïs Berg est son premier roman.  b9782824625249 0tMoi, Anaïs Berg.Le prix du roman de l'étéuhttps://www.base-orb.fr/product/9782824624464/show/y9782824624464  a809.3v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT300c22ORB-Code  aPoliciersc22ORB-Label  aLIT303c32ORB-Code  aThrillersc32ORB-Label 1aMcEvoybDiane4070 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782824625249-475x500-1.jpg  a103288cam# 2200517#i 450 orb9782917045930http://catalogue.bnf.fr/ark:/12148/cb47550352d  a978-2-917045-93-0bRel.d23.00 EUR  a(Abes)280175515#1a9782917045930  a20241121j20241115c  u0frey50      ba0 afre  aFR  aa   f   000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aFrontièresbTexte impriméfKarim Ressouni-DemigneuxgKarine Maincent  aPariscKilowattdDL 2024#0aPariscKilowattdDL 2024  a1 vol. (70 p.)cill. en coul.d32 cm x 24 cmf750 g  aDisponible  aQu'est-ce qu'une frontière?? Une montagne?? Une fortification?? Un tracé sur une carte?? Une ligne imaginaire sur un territoire?? Depuis quand les frontières existent-elles?? Comment passe-t-on les frontières?? Le texte répond à ces questions de façon essentielle en prenant comme point de départ l'histoire, et comme point d'arrivée les défis actuels de la géographie humaine. Les illustrations sont adaptées au lectorat et les anecdotes en marge rendent le propos très vivant. La maison d'édition a souhaité un documentaire «?pour des lecteurs de tous âges en quête d'informations et de divertissement?». Pari gagné?! En un clin d'œil, comprenez le traité de Westphalie ou le partage des zones maritimes ou aériennes.d20250301  aQu'est-ce qu'une frontière ? Une montagne ? Un tracé sur une carte ? Une ligne imaginaire ? Comment passe-t-on les frontières ? Comment sont-elles nées ? Le texte répond à ces questions en prenant comme point de départ l'histoire et comme point d'arrivée les défis actuels de la géographie humaine. Les anecdotes en marge rendent le propos très vivant. Conçu pour être lu à tout âge, ce livre permet de comprendre en un clin d'œil le traité de Westphalie ou le partage des zones maritimes.d20251101  aLes frontières délimitent les pays. Sur une carte de géographie, tout parait clairet ordonné. Mais en réalité, c'est bien différent. Pourquoi les frontières nous séparent-elles ? Depuis quand existent-elles ? Et quelles curiosités peuvent-elles bien cacher ?  aDe 6 à 10 ans  b9782917045930  311954113aFrontières2rameau  312042408aOuvrages pour la jeunesse2rameau  a320.120 83v23  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE700c22ORB-Code  aDocumentairesc22ORB-Label  aJE702c32ORB-Code  aDécouvertes - encyclopédies 6-10 ansc32ORB-Label 1aRessouni-DemigneuxbKarimf1965-....oISNI000000011471220X3136103104070 1aMaincentbKarinef1983-....oISNI00000003693399613165889794440 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20240905gAFNOR 0aFRbAbesc20250312gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782917045930-475x500-1.jpg  a102596cam# 2200517#i 450 orb9782357961258http://catalogue.bnf.fr/ark:/12148/cb48514581t  a978-2-35796-125-8bRel.d10.70 EUR  a(Abes)286015536#1a9782357961258  a20250424j20250425b  u0frey50      ba0 afre  aFR  aa       000yy  ar  601abbxb2e  602csti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLe renard rouxbTexte impriméfSylvain Bauduret, Yoann Thonnet  aAmienscEditions de la GouttièredDL 2025#0aAmienscEditions de la GouttièredDL 2025  a1 vol. (32 p.)cill. en coul.d23 cm x 18 cmf264 g  aDisponible  aVoici une bande dessinée de petit format, au trait rond et agréable, facile à prendre en main par les enfants. Sans texte, donc adaptée aux tout-petits, l'histoire se prête aussi aux échanges entre le parent et l'enfant au cours des aventures d'un renardeau dont on devine que la mère a été victime d'un chasseur. Le petit renard évite bien des dangers et finit par trouver refuge dans le jardin d'une adepte de la permaculture. Quatre pages documentaires en fin d'ouvrage permettent aux plus grands d'en apprendre davantage sur ce prétendu «?nuisible?», en réalité aide précieuse de l'agroécologie.d20260101  aUn renardeau et sa maman partent en recherche de nourriture... Mais lorsque la renarde se retrouve coincée dans un piège, le petit désormais seul n'a d'autre choix que d'apprendre à chasser par lui-même ! Tiens, il semble y avoir quelque chose d'intéressant du côté de ce potager...  aÀ partir de 3 ans  b9782357961258 0tLe monde sauvage  311932700aRenards2rameau  311931019aBandes dessinées2rameau  312042408aOuvrages pour la jeunesse2rameau  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE200c22ORB-Code  aLivres 3 ans et +c22ORB-Label  aJE203c32ORB-Code  aAlbumsc32ORB-Label 1aBauduretbSylvain4070 1aThonnetbYoann4070 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20250522gAFNOR 0aFRbAbesc20250903gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782357961258-475x500-1.jpg  a102497cam# 2200505#i 450 orb9782344068564http://catalogue.bnf.fr/ark:/12148/cb48753556j  a978-2-344-06856-4bRel.d18.00 EUR  a(Abes)29644913X#1a9782344068564  a20260407j20260408a  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aAna et l'EntremondebTexte impriméfMarc DubuissongCygNota Bene  aGrenoblecGlénatdDL 2026#0aGrenoblecGlénatdDL 2026  a1 vol. (104 p.)cill. en coul.d29 cm x 21 cmf670 g  aDisponible  aQuand les portes de L'Entremonde s'ouvrent enfin... Ana et Domingo, deux jeunes orphelins embarqués par accident dans la fameuse expédition de Christophe Colomb, se sont retrouvés projetés dans l'Entremonde, un univers fantastique peuplé de pirates en tous genres ! Tandis que La Main continue d'étendre son pouvoir sur Kawa-Qawa, Ana et ses amis sont plus déterminés que jamais à l'arrêter avant que les mystérieuses Portes-aux-mondes ne tombent en sa possession. Entre surprises, révélations et bataille navale explosive, l'ultime tome de la série nous plonge dans une aventure fantastique pleine d'imagination et de rebondissements avec, toujours, des planches en couleur directe à couper le souffle !  b9782344068564 0tAna et l'Entremonde - Tome 04.uhttps://www.base-orb.fr/product/9782331091483/show/y9782331091483 0tAna et l'Entremondev4  311931019aBandes dessinées2rameau  a741.5v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD100c22ORB-Code  aBD jeunessec22ORB-Label  aBD102c32ORB-Code  aSF - Fantasy - Fantastiquec32ORB-Label 1aDubuissonbMarcf1983-....oISNI00000000658895423160879554690 1aCyf1990-....oISNI00000004601228353171161724440  aNota Bene4075 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260417gAFNOR 0aFRbAbesc20260604gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782344068564-475x500-1.jpg  a103788cam# 2200493#i 450 orb9782344071588http://catalogue.bnf.fr/ark:/12148/cb48763916m  a978-2-344-07158-8bRel.d16.00 EUR#1a9782344071588  a20260421j20260422m  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLa tempête des destinsbTexte impriméfVictor DixengMaria Francesca PerifanogAndre Vazzios  aGrenoblecGlénatdDL 2026#0aGrenoblecGlénatdDL 2026  a1 vol. (56 p.)cill. en coul.d32 cm x 24 cmf650 g2 a24x32  aDisponible  aUne lutte pour la survie. Une course pour le pouvoir. Une tornade de souvenirs. Ils tentent de survivre envers et contre tout. Cantonnés dans la base martienne, sous la menace imminente d'une tempête, les pionniers du programme Genesis tentent de comprendre ce qui.est arrivé aux cobayes du rapport Noé afin de ne pas subir le même sort. Elle voudrait aimer sans baisser sa garde. Léonor est tiraillée entre le désir de se laisser emporter dans une histoire d'amour folle avec Marcus, et la responsabilité de continuer le bras de fer avec Serena McRée. D'autant que les autres pionniers, victimes du syndrome de Stockholm, succombent les uns après les autres à l'emprise de leur tortionnaire... Même si les éléments s'apprêtent a tout dévaster, il est trop tard pour oublier. L'adaptation en bande dessinée de la saga phénomène de Victor Dixen, un thriller de science-fiction best-seller international, mariant romance spatiale et course pour la survie.  aVictor Dixen est un scénariste et écrivain français Nomade, il a vécu à Paris, Dublin, Singapour, New York, et habite aujourd'hui à Washington D.C. Il est l'auteur de plus d'une douzaine de romans, dont les séries Phobos, Vempyria, Agence Perdido et Les Mystères d'Eversend. Son oeuvre, saluée autant parle public que la critique, est traduite dans douze langues, dont l'anglais. Il a reçu de nombreuses récompenses, dont deux Grand Prix de l'Imaginaire Jeunesse (En 2010 pour Le Cas Jack Spark et 2014 pour Animale), deux Prix Imaginales 2016 pour Phobos et 2020 pour Cogito) in Prix Chimères (En 2016 pour Phobos). Maria Francesca Perifano, née en 1994 a Benevento (Italie), a toujours voulu devenir dessinatrice de bande dessinée. Elle a étudié à l'école de bande dessinée de Milan et travaillé en parallèle de ses études, tant pour des clients publics (y compris Treccani Enciclopedia, en tant qu'Illustratrice), que pour des clients privés. Elle a travaillé comme dessinatrice pour Cronaca di Topolinia et les Humanoïdes Associés, et actuellement pour La Boite à Bulles et Glénat Dans ses bandes dessinées, elle préfère un style réaliste et accorde une attention particulière aux détails.  b9782344071588 0t24x32 0tPhobosv4  a741.56v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD300c22ORB-Code  aBD tout publicc22ORB-Label  aBD303c32ORB-Code  aScience-Fictionc32ORB-Label 1aDixenbVictorf1979-....oISNI00000000728905333161556794690 1aPerifanobMaria Francesca4440 1aVazziosbAndre4410 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260512gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782344071588-475x500-1.jpg  a102516cam# 2200469#i 450 orb9782344076088  a978-2-344-07608-8bBr.d10.00 EUR  a(Abes)297754599#1a9782344076088  a20260610j20260610m  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxeabbxb2e  601ctxtcsti2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aTerra AustralisbTexte impriméfLaurent-Frédéric BolléegPhilippe Nicloux  aGrenoblecGlénatdDL 2026#0aGrenoblecGlénatdDL 2026  a1 vol. (256 p.)cill. en coul.d19 cm x 15 cmf492 g2 aBD poche  aDisponible  aUne des plus incroyables odyssées humaines de l'Histoire a eu lieu il y a un peu plus de 220 ans. Environ 1 500 hommes et femmes ont été déportés, entassés à bord de 11 navires, parcourant plus de 24 000 km sur trois océans. Ils étaient des bagnards, des forçats, des condamnés... le rebut de l'Angleterre ! On les a envoyés à l'autre bout du monde, dans un pays qui n'existait pas encore. Aller sans retour vers l'enfer ou chance inespérée d'une nouvelle vie ? Plus rien ne sera comme avant autour de ce nouveau monde, issu d'une terre ancestrale que les habitants d'origine appelaient Bandaiyan... Laurent-Frédéric Bollée livre ici son From Hell, une oeuvre magistrale de plus de 500 pages dessinées avec brio au lavis par Philippe Nicloux. Une création sans précédent dans l'histoire de la bande dessinée française et internationale.  b9782344076088 0tBD poche 0tTerra Australisv2  311978365aColonies pénitentiaires311930990yAustralie311976032zXVIIIe siècle311931019xBandes dessinées2rameau  311931019aBandes dessinées2rameau  a741.56v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD300c22ORB-Code  aBD tout publicc22ORB-Label 1aBolléebLaurent-Frédéricf1967-....oISNI00000001227972073135577874690 1aNiclouxbPhilippeoISNI00000000047153543157778524440 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20260626gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782344076088-475x500-1.jpg  a102654cam# 2200433#i 450 orb9782344074060  a978-2-344-07406-0bRel.d12.00 EUR#1a9782344074060  a20260603j20260603a  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxeabbxb2e  601ctxtcsti2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLa Citadelle de JomsborgbTexte impriméeAvec un poster à collectionner offertfJérôme Le GrisgLetizia Depedri  aGrenoblecGlénatdDL 2026#0aGrenoblecGlénatdDL 2026  a1 vol. (56 p.)cill. en coul.d29 cm x 21 cmf542 g  aDisponible  aUn serment est un serment ! Skara a ouvert par mégarde les portes entre les Neuf Royaumes et libéré sur Midgard des créatures maléfiques venues des mondes inférieurs ! Elle doit désormais réparer sa faute en chassant ces monstres, accompagnée de Bojan, un jeune prêtre russe et de Rùna, une sulfureuse sorcière. Mais quand Bojan est gravement blessé, elles n'ont comme seule solution dans ces territoires glacés que de rejoindre la citadelle de Jomsborg l'imprenable et obtenir l'aide des Jomsvikings, les guerriers les plus dangereux de tout Midgard. Mais pour obtenir leur aide, Skara doit défier leur chef dans un duel à mort... Avec ce récit mettant en scène une jeune adolescente au caractère colérique en quête de rédemption, Jérôme Le Gris et Letizia Depedri signent une série épique au ton décalé. Mêlant action, loyauté et sororité, le duo nous plonge dans un récit sans temps mort où l'imaginaire de la mythologie nordique sert de décor au parcours initiatique jalonné d'épreuves de leur héroïne.  b9782344074060 0tSkara, chasseuse de monstres - Tome 02.La Citadelle de Jomsborguhttps://www.base-orb.fr/product/9782331092091/show/y9782331092091 0tSkara, chasseuse de monstresv2  a741.5v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD100c22ORB-Code  aBD jeunessec22ORB-Label  aBD102c32ORB-Code  aSF - Fantasy - Fantastiquec32ORB-Label 1aLe GrisbJérômef1971-....oISNI00000001192705863165040504690 1aDepedribLetiziaf1994-....3181157164440 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782344074060-475x500-1.jpg  a102203cam# 2200445#i 450 orb9782302107595  a978-2-302-10759-5bRel.d11.50 EUR#1a9782302107595  a20260428j20260430a  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxeabbxb2e  601ctxtcsti2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aIl était une foisbTexte impriméfJean-Christophe Derrien,  FrigielgArianna Sabella  aToulon cedexcSoleil ProductionsdDL 2026#0aToulon cedexcSoleil ProductionsdDL 2026  a1 vol. (56 p.)cill. en coul.d30 cm x 21 cmf422 g  aDisponible  aPour l'anniversaire de Frigiel (il a déjà 20 ans ! ), Abel a enfin terminé son autobiographie, où il évoque toutes les histoires précédentes de nos héros... mais de son point de vue ! A Lanniel, on prépare une surprise pour l'anniversaire de Frigiel : une grande fête pour ses 20 ans ! Et c'est aussi l'occasion pour Abel de dévoiler enfin son autobiographie longtemps promise... où il va revenir sur son parcours et toutes les aventures avec ses compagnons. Mais, comme toujours, notre bâtisseur préféré a sa propre vision des choses... contredite parfois par ses amis.  b9782302107595 0tFrigiel et Fluffy Tome 20 : Il était une foisuhttps://www.base-orb.fr/product/9782302131583/show/y9782302131583 0tFrigiel et Fluffyv20  a741.508 3v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD100c22ORB-Code  aBD jeunessec22ORB-Label  aBD101c32ORB-Code  aAventurec32ORB-Label 1aDerrienbJean-Christophef1971-....oISNI00000001165569253144913164690 1aFrigieloISNI00000004651871873170806344690 1aSabellabArianna4440 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782302107595-475x500-1.jpg  a104205cam# 2200505#i 450 orb9782375024812  a978-2-37502-481-2bBr.d21.00 EUR  a(Abes)297088556#1a9782375024812  a20260505j20260507u  u0frey50      ba1 afrecita  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLe gardien de la colline aux cerisiersbTexte impriméfFranco Faggianigtraduit de l'italien par Anaïs Bouteille-Bokobza  aPariscEditions PaulsendDL 2026#0aPariscEditions PaulsendDL 2026  a1 vol. (230 p.)d21 cm x 14 cmf254 g2 aLa Grande Ourse  aDisponible  aInspiré d'une histoire vraie, ce roman est une ode à la halte et au sens qu'on trouve chemin faisant. A l'approche des jeux olympiques de 1912, l'empereur Mutsuhito, désireux de renforcer ses relations diplomatiques avec l'Occident, a besoin d'athlètes pour défendre les couleurs du Japon. Tous les jours, à l'aube, le jeune Shizo Kanakuri parcourt les versants boisés qui bordent la demeure de ses parents. C'est ainsi que ce coureur solitaire se sent vivant et éprouve les bienfaits de la nature. Sa foulée remarquable et l'étrange grâce avec laquelle il court retiennent l'attention d'un entraîneur qui le prépare au marathon des jeux olympiques de Stockholm. Alors que les sportifs japonais sont rares à s'illustrer dans la pratique des sports occidentaux, Shizo est le favori de l'épreuve. Pourtant, à sept kilomètres de la ligne d'arrivée, il se volatilise. Une singulière fugue qui fait dévier le cours de son destin. Il lui faudra 54 ans, 8 mois, 6 jours, 5 heures, 32 minutes et 20 secondes pour venir à bout de son marathon. Un détour qui lui permettra de trouver un sens à sa vie. " Délicat et profond, un formidable roman picaresque inspiré de faits réels. " Corriere della Sera " Le roman de Faggiani possède le don rare d'envoûter le lecteur dès les premières pages comme une fable sur les caprices du destin. " La Stampa " La biographie romancée de Faggiani exalte notre vie spirituelle, célèbre la course à pied comme une forme de prière et invite à un mysticisme de la nature. " La Repubblica " Faggiani parvient à saisir l'instant et à le faire éclore, créant ainsi une littérature de la nature où se mêlent l'infiniment petit et l'infiniment grand. " Il Foglio " La sérénité et la beauté qui émanent de la prose de Faggiani, ravivent à chaque page notre désir de contempler la nature. " Luca Mercalli Prix Biblioteche di Roma 2019 Première sélection du Prix Bancarella 2020  aFranco Faggiani vit à Milan. Journaliste et promeneur solitaire, il est passionné d'histoire, de géographie et de montagne, et s'évade dès que son travail le lui permet. Cet éloignement de la ville est selon lui le premier pas décisif du changement radical que chacun de nous souhaiterait opérer tôt ou tard. Son oeuvre littéraire, qui explore le pouvoir de consolation de la nature, a été plusieurs fois récompensée.  b9782375024812 0tLa Grande Ourse 0tLe gardien de la colline aux cerisiersuhttps://www.base-orb.fr/product/9782375024829/show/y9782375024829 0tIl guardiano della collina dei ciliegi  312019795aRoman italien313536525z2001-2025318262925zXXIe siècle2rameau  a853v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT500c22ORB-Code  aLittérature étrangèrec22ORB-Label  aLIT505c32ORB-Code  aLittérature italiennec32ORB-Label 1aFaggianibFranco3178058714070 1aBouteille-BokobzabAnaïsf1976-....oISNI00000000349949563145864694730 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20260703gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782375024812-475x500-1.jpg  a103070cam# 2200589#i 450 orb9782808700481http://catalogue.bnf.fr/ark:/12148/cb48666656k  a978-2-8087-0048-1bBr.d12.50 EUR#1a9782808700481  a20251107j20251107m  u0frey50      ba1 afrecjpn  aBE  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLes Mystères de la Résidence KaikabTexte impriméfAmeishigtraduit du japonais par Axelle Wasier  aMarcinellecVega-DupuisdDL 2025#0aMarcinellecVega-DupuisdDL 2025  a1 vol. (178 p.)cill.d21 cm x 15 cmf260 g2 aAlpha  aDisponible  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_3-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_4-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_5-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_6-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_7-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481_8-475x500-1.jpg  aSouhaitant que le grand oeuvre de son maître soit publié dans son intégralité, Fuji continue d'en expédier les chapitres "retrouvés" à son éditeur, mais celui-ci commence à suspecter Fuji d'être depuis le début le véritable auteur de ce chef-d'oeuvre. Par ailleurs, la résidence Kaika continue de nous dévoiler ses résidents et leurs secrets : un peintre et sa nièce qui entretiennent une relation tortueuse à travers la peinture, ou un jeune orphelin qui fréquente une école prestigieuse mais qui se sent inférieur en raison de ses origines.  b9782808700481 0tAlpha 0tLes Mystères de la Résidence Kaika Tome 2uhttps://www.base-orb.fr/product/9782808700498/show/y9782808700498 0tKaika Apartment 0tLes Mystères de la Résidence Kaikav2  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-05c42ORB-Code  aSeinen (homme)c42ORB-Label 1aAmeishi4070 1aWasierbAxelle4730 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20251215gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808700481-475x500-1.jpg  a102332cam# 2200469#i 450 orb9782810207121http://catalogue.bnf.fr/ark:/12148/cb48745204r  a978-2-8102-0712-1bRel.d28.00 EUR  a(Abes)296729124#1a9782810207121  a20260413j20260415m  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLa Langue des VipèresbTexte impriméfJuliette Brocal  aPariscRue de SèvresdDL 2026#0aPariscRue de SèvresdDL 2026  a1 vol. (224 p.)cill. en coul.d32 cm x 24 cmf1448 g  aDisponible  aFille illégitime d'un important prélat, Iodis a grandi à l'abbaye de Réol aux côtés de jeunes nobles mieux nés. Elle y étudie la Langue, une magie liturgique répondant par des visions aux questions de ceux qui la maîtrisent. Espérant échapper à la vie monastique en étant choisie comme Doctorante, Iodis trouve une rivale déterminée en la personne d'Halcyon de Monterréol, une nouvelle venue à qui tout semble réussir et dont les manières fuyantes lui semblent aussitôt suspectes. Lorsqu'un précieux tableau et le moine qui le peignait disparaissent en laissant derrière eux les traces d'une violente altercation, Iodis n'a plus de doute : Halcyon sait quelque chose et cache un secret qui pourrait compromettre l'abbaye tout entière.  b9782810207121 0tLa Langue des Vipèresuhttps://www.base-orb.fr/product/9782810213573/show/y9782810213573  311931019aBandes dessinées2rameau  a741.56v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD300c22ORB-Code  aBD tout publicc22ORB-Label  aBD302c32ORB-Code  aFantasyc32ORB-Label 1aBrocalbJuliette4070 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260401gAFNOR 0aFRbAbesc20260527gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782810207121-475x500-1.jpg  a102891cam# 2200481#i 450 orb9782810209637http://catalogue.bnf.fr/ark:/12148/cb48749220z  a978-2-8102-0963-7bRel.d12.00 EUR  a(Abes)298102668#1a9782810209637  a20260414j20260415a  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aComment embobiner la momiebTexte impriméfFabrice ParmegVéronique Dreher  aPariscRue de SèvresdDL 2026#0aPariscRue de SèvresdDL 2026  a1 vol. (30 p.)cill. en coul.d28 cm x 21 cmf380 g  aDisponible  aMonsieur de Rosette, le célèbre égyptologue a découvert un incroyable tombeau pharaonique. Le sarcophage va être envoyé aux Etats-Unis pour être conservé dans un musée ! Karnak, un étrange client désargenté du Grand Louxor Hotel, saisit l'occasion : ce sarcophage serait une cache idéale pour lui, l'occasion de fuir en toute discrétion sans régler sa note... Il n'y a plus qu'à se déguiser, s'allonger et remplacer la momie qui s'y trouve déjà. Mais cette dernière n'a pas dit son dernier mot... Une nouvelle enquête pour Astrid qui embarque elle aussi sur le paquebot. Une traversée qui s'annonce mouvementée !  aNé près de Nancy en 1966, Fabrice Parme fréquente l'école Duperré avant d'intégrer la prestigieuse Ecole supérieure de l'image d'Angoulême. Scénariste et dessinateur, il fait ses débuts dans la bande dessinée et le dessin animé à seulement 22 ans. Dans le domaine de l'anmation, on lui doit notamment la création de la série La Famille Pirate. En bande dessinée, il collabore régulièrement avec Lewis Trondheim, et publie chez Rue de Sèvres en auteur complet la série jeunesse Astrid Bromure. Il vit aujourd'hui à Orsay.  b9782810209637 0tAstrid Bromure Tome 9 : Comment embobiner la momieuhttps://www.base-orb.fr/product/9782810213566/show/y9782810213566 0tAstrid Bromurev9  316555361aBandes dessinées humoristiques2rameau  a741.508 3v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD100c22ORB-Code  aBD jeunessec22ORB-Label 1aParmebFabriceoISNI00000001077934433122244574070 1aDreherbVéroniqueoISNI00000000054234333151168114410 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260408gAFNOR 0aFRbAbesc20260716gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782810209637-475x500-1.jpg  a101825cam# 2200433#i 450 orb9782812941498  a978-2-8129-4149-8bBr.d19.90 EUR#1a9782812941498  a20260702j20260702m  u0frey50      ba0 afre  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aL'Enfant du paysbTexte impriméfAlain Pyre  aClermont-Ferrand cx 2cEditions De BoréedDL 2026#0aClermont-Ferrand cx 2cEditions De BoréedDL 2026  a1 vol. (272 p.)d23 cm x 14 cmf304 g2 aTerres d'écriture  aDisponible  aAu coeur de ce petit village des Pyrénées, on se réjouit du retour de Bérénice sur les terres de son enfance. Mais désormais mariée à Samy et mère d'un petit Paul, c'est avec un projet immobilier ambitieux qu'elle revient, suscitant rapidement la méfiance des habitants. Malgré l'hostilité ambiante, le jeune couple se lance à corps perdu dans les travaux. Jusqu'au jour où Paul disparaît...  b9782812941498 0tTerres d'écriture 0tL'Enfant du paysuhttps://www.base-orb.fr/product/9782812963452/show/y9782812963452  a843v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLITD00c22ORB-Code  aRomans de terroirc22ORB-Label  aLITD12c32ORB-Code  aMidi-Pyrénéesc32ORB-Label 1aPyrebAlain3169782604070 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782812941498-475x500-1.jpg  a103450cam# 2200481#i 450 orb9782749185576  a978-2-7491-8557-6bBr.d22.00 EUR  a(Abes)297449710#1a9782749185576  a20260414j20260416m  u0frey50      ba1 afreceng  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLes SilencieusesbTexte impriméfAnna McPartlingtraduit de l'anglais par Valérie Le Plouhinec  aPariscLe Cherche MididDL 2026#0aPariscLe Cherche MididDL 2026  a1 vol. (406 p.)d22 cm x 14 cmf432 g  aDisponible  aComté de Kerry, 1980 : l'assassinat d'un innocent fait vaciller l'Irlande tout entière. Le portrait palpitant d'une époque et d'un pays. Par un matin glacé de janvier 1980, sur une plage battue par les vents du Kerry, on découvre le corps d'un nouveau-né abandonné au creux d'une dune. La première à arriver sur les lieux est Mary Shea, jeune garda de la police locale. Très vite, l'affaire prend une ampleur nationale : une équipe d'enquêteurs de Dublin est dépêchée sur place. Mais dans le Kerry, les secrets se taisent et les langues ne se délient pas facilement. Seule Mary, qui connaît mieux que quiconque les usages de sa ville, parvient à convaincre certaines femmes de témoigner. Impressionné, l'inspecteur Matt Foley, chargé de l'enquête la plus décisive de sa carrière, demande que Mary l'assiste. A mesure que l'investigation avance, les certitudes s'effritent. Dans cette petite ville où règnent les non-dits, où chaque foyer semble abriter une part d'ombre et chaque habitant dissimuler une vérité, une question obsède Mary : qui a pu commettre l'impensable ? Un polar captivant et un portrait saisissant d'une époque et d'un lieu. Mary Shea est une héroïne magistrale : intuitive, audacieuse, profondément humaine et bien en avance sur son temps. A lire absolument. Louise Candlish  aAnna McPartlin se distingue par la force de ses personnages et la précision de ses dialogues, héritage de nombreuses années d'écriture. On lui doit notamment Les Derniers Jours de Rabbit Hayes , salué par la critique et les lecteurs lors de sa parution en 2016. Co-créatrice et productrice exécutive de la série The Gone , elle signe ici son premier thriller. Un ouvrage captivant inspiré d'un fait réel, où chaque page nous réserve un rebondissement.  b9782749185576 0tLes Silencieusesuhttps://www.base-orb.fr/product/9782749185583/show/y9782749185583 0tThe Silent Ones  312012110aRoman policier anglais313536525z2001-2025318262925zXXIe siècle2rameau  a809.3v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT300c22ORB-Code  aPoliciersc22ORB-Label  aLIT305c32ORB-Code  aRomans policiersc32ORB-Label 1aMcPartlinbAnna4070 1aLe PlouhinecbValérieoISNI00000001213446793155548894730 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20260702gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782749185576-475x500-1.jpg  a102907cam# 2200493#i 450 orb9782762146219http://catalogue.bnf.fr/ark:/12148/cb475803432  a978-2-7621-4621-9bRel.d21.00 EUR#1a9782762146219  a20240927j20241003c  u0frey50      ba0 afre  aCA  aa       000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aHistoires de constructions et monuments incroyablesbTexte impriméfEvelyne FerrongJordanne Maynard  aSaint-laurentcFides (Editions)dDL 2024#0aSaint-laurentcFides (Editions)dDL 2024  a1 vol. (46 p.)cill. en coul.d25 cm x 20 cmf388 g2 aCivilisations  aDisponible  aDécouvre les secrets que cachent les monuments les plus fascinants de notre planète. Une pyramide faite de 2 millions de pierres ! Un palais aussi grand qu'une ville ! Un temple qui cache un trésor inestimable ! Ou encore une muraille si longue qu'elle pourrait faire le tour des Etats-Unis ! Depuis la nuit des temps, les humains sont d'incroyables bâtisseurs. Sans outils spécialisés ni logiciels, ils ont notamment réussi à creuser un tombeau à même une falaise, à bâtir des châteaux dignes d'un conte de fées et à ériger des structures si hautes qu'elles semblent toucher le ciel ! A travers les pages de ce livre, visite ces édifices aussi bizarres que surprenants et rencontre les peuples qui les ont construits. La collection d'albums documentaires Civilisations remonte le temps pour explorer l'histoire du monde à travers des thèmes originaux et des faits scientifiques... étonnants et amusants !  aÀ partir de 6 ans  aEvelyne Ferron partage sa passion de l'histoire et de l'archéologie à la télé, à la radio, dans les journaux et aussi avec son balado jeunesse intitulé " L'incroyable Histoire ". Elle enseigne l'histoire au Cégep et à l'Université depuis plus de quinze ans.  b9782762146219 0tCivilisations 0tCivilisations: Histoires de constructions et monuments incroyablesuhttps://www.base-orb.fr/product/9782762146264/show/y9782762146264  a930.083v23  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE700c22ORB-Code  aDocumentairesc22ORB-Label  aJE704c32ORB-Code  aHistoire dès 6 ansc32ORB-Label 1aFerronbEvelyne4070 1aMaynardbJordanne4440 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20241015gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782762146219-475x500-1.jpg  a102393cam# 2200505#i 450 orb9782755677843http://catalogue.bnf.fr/ark:/12148/cb47612011t  a978-2-7556-7784-3bRel.d24.95 EUR  a(Abes)282026134#1a9782755677843  a20241202j20241204m  u0frey50      ba1 afreceng  aFR  aa   t   000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aUnordinarybTexte impriméfUru-changtraduit de l'anglais par Caroline de Hugo  aPariscNeotoondDL 2024#0aPariscNeotoondDL 2024  a1 vol. (336 p.)cill. en coul.d22 cm x 15 cmf772 g  aDisponible  aDepuis que l'as de Wellston, Séraphina, a été suspendue, la hiérarchie de l'école est instable. Non seulement les haut niveau sont à cran, mais en plus le personnage de zéro soigneusement construit par John pour fuir son ancienne vie commence à s'effriter... Arlo va tout faire pour pousser John dans ses retranchements et découvrir la vérité, mais est-il prêt à en payer le prix ? Néanmoins, lorsqu'une menace extérieure risque de coûter la vie de Séraphina, Arlo et John sont forcés de s'allier pour essayer de la sauver. Ce duo improbable réussira-t-il cette mission ? Qui est derrière cette conspiration ? Ennemis mortels, binôme insolite, combats épiques... La vie "ordinaire" de Wellston réserve bien des surprises !  b9782755677843 0tUnOrdinary 0tUnordinaryv2  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-10c42ORB-Code  aThème diversc42ORB-Label 1aUru-chan4070 1aHugobCaroline def1956-....oISNI00000001403539843145172894730 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20241205gAFNOR 0aFRbAbesc20260505gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782755677843-475x500-1.jpg  a102475cam# 2200529#i 450 orb9782808507585http://catalogue.bnf.fr/ark:/12148/cb48742002s  a978-2-8085-0758-5bRel.d29.95 EUR  a(Abes)297901338#1a9782808507585  a20260521j20260522m  u0frey50      ba0 afre  aBE  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aGunnar le vampirebTexte impriméfNicolas DumontheuilgIsabelle Merlet  aMarcinellecEditions DupuisdDL 2026#0aMarcinellecEditions DupuisdDL 2026  a1 vol. (272 p.)cill. en coul.d31 cm x 23 cmf1500 g2 aAire libre  aDisponible  aGunnar Gunnarson est un vampire suédois de près de 800 ans. Ou plutôt, comme il aime à le dire : il a 36 ans depuis plus de 7 siècles... Lassé de le violence et de la prédation, Gunnar essaie de bien se conduire, et vit paisiblement en Bourgogne avec sa compagne Marthe, une mortelle. Il est couturier, reste discret, mord rarement et uniquement des consentants. La population locale reste à distance, partagée entre méfiance, curiosité et fierté. Tout le monde le laisse en paix. Jusqu a ce que des animaux soient retrouvés vidés de leur sang dans les fermes alentour...  b9782808507585 0tAire libre 0tGunnar le vampireuhttps://www.base-orb.fr/product/9782808518055/show/y9782808518055  312647510aMarginaux311931409yFinlande2rameau  311945972aVampires2rameau  311931019aBandes dessinées2rameau  a741.56v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD300c22ORB-Code  aBD tout publicc22ORB-Label  aBD312c32ORB-Code  aFantastiquec32ORB-Label 1aDumontheuilbNicolasf1967-....oISNI00000000504273963123211734070 1aMerletbIsabellef1967-....oISNI00000001214336123160732664410 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260327gAFNOR 0aFRbAbesc20260707gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782808507585-475x500-1.jpg  a102123cam# 2200421#i 450 orb9782749964003  a978-2-7499-6400-3bBr.d21.95 EUR#1a9782749964003  a20260512j20260513m  u0frey50      ba0 afre  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLa fabrique du malbTexte impriméfAngélina Delcroix  aNeuilly-sur-Seine cdxcMichel LafondDL 2026#0aNeuilly-sur-Seine cdxcMichel LafondDL 2026  a1 vol. (453 p.)d22 cm x 14 cmf492 g  aDisponible  aLe nouveau thriller événement d'Angélina Delcroix après le best-seller Mémoires d'un expert psychiatre . " Un chef d'oeuvre. Terrifiant, magistralement écrit, inoubliable. " Jean-Michel Barland, La Provence A quinze ans, on devrait encore être un enfant. Pas un tueur. Un thriller glaçant et contemporain.  aAngelina Delcroix est romancière et psychothérapeute diplômée en criminologie. Plébiscitée par le public et la critique, elle a été couronnée du prix du Festival Polar de Cognac pour Mémoires d'un expert psychiatre (numéro 1 des ventes de romans policiers français en 2025). Avec La Fabrique du mal , elle signe un roman électrisant sur l'engrenage de la violence qui précipite de jeunes adolescents entre les mains d'organisations criminelles.  b9782749964003 0tLa fabrique du maluhttps://www.base-orb.fr/product/9782749965857/show/y9782749965857  a809.3v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT300c22ORB-Code  aPoliciersc22ORB-Label  aLIT303c32ORB-Code  aThrillersc32ORB-Label 1aDelcroixbAngélina4070 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782749964003-475x500-1.jpg  a102473cam# 2200409#i 450 orb9782702192832http://catalogue.bnf.fr/ark:/12148/cb48742053p  a978-2-7021-9283-2bBr.d18.50 EUR#1a9782702192832  a20260309j20260311m  u0frey50      ba0 afre  aFR  ay###    000ay  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aTendre MarocbTexte impriméfEmmanuelle de Boysson  aPariscCalmann-LévydDL 2026#0aPariscCalmann-LévydDL 2026  a1 vol. (211 p.)d21 cm x 13 cmf275 g  aDisponible  a" Il ne faut jamais revenir sur les lieux de son enfance, de crainte d'en brouiller le souvenir. " Dans la maison de campagne familiale, Emma retrouve les vieux agendas de sa mère. Et le souvenir de son enfance au Maroc. Par petites touches impressionnistes, elle fait revivre ses années à Mohammedia, l'odeur des orangers, la douceur des cornes de gazelle, les jeux avec ses frères et soeur dans le jardin et le cri des mouettes sur le port. Une enfance heureuse, privilégiée. Même si Emma, timide et rêveuse, ne cesse de chercher l'affection de Blanche, une mère fascinante, plus préoccupée par les défavorisés que par les siens. Plus tard, la jeune fille, alors pensionnaire à Casablanca, se met à écrire. Dans l'espoir que la littérature, ainsi que le vent de liberté des années 1970 et l'amitié complice avec sa cousine, l'aident à s'émanciper d'un milieu où, derrière les visages souriants, le chagrin affleure. Dans ce roman solaire, Emmanuelle de Boysson ressuscite un temps perdu où chaque instant est une aventure et s'interroge sur la force de la transmission.  b9782702192832 0tTendre Maroc.uhttps://www.base-orb.fr/product/9782702192450/show/y9782702192450  a843v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT100c22ORB-Code  aLittérature françaisec22ORB-Label 1aBoyssonbEmmanuelle deoISNI00000000631056363135050974070 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260327gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782702192832-475x500-1.jpg  a103406cam# 2200505#i 450 orb9782702190784  a978-2-7021-9078-4bBr.d22.90 EUR  a(Abes)297726986#1a9782702190784  a20260518j20260520m  u0frey50      ba1 afrecswe  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLe vent de NorrbergabTexte impriméfCamilla Grebe, Carl-David Pärsongtraduit du suédois par Anna Gibson  aPariscCalmann-Lévy noirdDL 2026#0aPariscCalmann-Lévy noirdDL 2026  a1 vol. (418 p.)d23 cm x 15 cmf520 g  aDisponible  aLa jeune policière Alba est convaincue que Norrberga, où elle a été mutée après avoir agressé un collègue, est une petite ville où il ne se passe jamais rien. Elle se trompe. Leo, père d'une enfant de quatre ans pleine de vie, espère qu'un déménagement dans une ferme idyllique aidera sa famille à surmonter la mort tragique de leur fille aînée. Il se trompe. Marika, la femme de Leo, n'est pas à l'aise dans ce cadre pourtant calme et paisible, elle pressent que le pire est à venir. Et elle a raison. Dans ce thriller aux accents surnaturels, Camilla Grebe et Carl-David Pärson brouillent la frontière entre rêve et réalité, mensonge et vérité en nous offrant un roman haletant de bout en bout.  aDès la parution de son premier livre, Un cri sous la glace, Camilla Grebe s'est imposée comme une voix incontournable du polar scandinave. Depuis, ses ouvrages ont été traduits en plus de vingt-cinq langues et se sont vendus à plus de 2,5 millions d'exemplaires à travers le monde. Ses romans lui ont valu de nombreux prix littéraires, dont le Grand Prix des lectrices ELLE et le Prix des lecteurs du Livre de Poche. Issu du milieu de l'audiovisuel et du gaming, Carl-David Pärson vit à New York depuis de nombreuses années. Le Vent de Norrberga est son premier roman, écrit à quatre mains avec sa mère, Camilla Grebe. Anna Gibson est une traductrice du suédois et de l'anglais vers le français, connue pour ses traductions d'auteurs comme Henning Mankell, Monika Fagerholm ou encore Colm Tóibín.  b9782702190784 0tLe Vent de Norrberga. 2 CD audio MP3uhttps://www.base-orb.fr/product/9791035423544/show/y9791035423544 0tLe Vent de Norrberga.uhttps://www.base-orb.fr/product/9782702190982/show/y9782702190982 0tLanaren  312048648aRoman policier suédois313536525z2001-2025318262925zXXIe siècle2rameau  a809.3v23  aLITc12ORB-Code  aLittératurec12ORB-Label  aLIT300c22ORB-Code  aPoliciersc22ORB-Label  aLIT303c32ORB-Code  aThrillersc32ORB-Label 1aGrebebCamillaf1968-....oISNI00000001099724613162110204070 1aPärsonbCarl-David4070 1aGibsonbAnnaf1963-....oISNI00000001211726783121464574730 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20260721gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9782702190784-475x500-1.jpg  a102377cam# 22004811i 450 orb9791032723838  a979-10-327-2383-8bBr.d7.95 EUR#1a9791032723838  a20260702j20260702m  u0frey50      ba1 afrecjpn  aFR  aa   t   000yy  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLe palais des assassinsbTexte impriméfTabasa Iorigtraduit du japonais par Djamel Rabahi  aPariscEditions Ki-oondDL 2026#0aPariscEditions Ki-oondDL 2026  a1 vol.cill.d18 cm x 13 cmf174 g2 aSeinen  aDisponible  aPlus facile d'assassiner ses ennemis que de se faire des amis ! La cour intérieure est en pleine effervescence, et pour cause : la grande impératrice douairière y organise une fastueuse réception. A cette occasion, elle commande une tenue d'apparat à son tailleur favori... qui n'est autre qu'U, le 11e fils d'O Ko ! Toutefois, en constatant qu'un intrus s'est introduit dans les appartements mis à la disposition de son frère, Karin craint qu'une personne malintentionnée profite du banquet pour assassiner la vieille dame tout en faisant porter le chapeau au jeune couturier... Mais qui au palais pourrait se rendre coupable d'un tel crime ? Et surtout, dans quel but ? Comment fraterniser dans un nid de vipères ? Le Palais des assassins vous entraîne dans l'univers d'une héroïne aussi habile au combat que maladroite en amitié !  b9791032723838 0tSeinen 0tAnsatsu kokyu - Ansatsu nyokan karin wa yuttari ikitai 0tLe palais des assassinsv9  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-05c42ORB-Code  aSeinen (homme)c42ORB-Label 1aIoribTabasa4070 1aRabahibDjamel3167995264730 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791032723838-475x500-1.jpg  a103242cam# 2200625#i 450 orb9791040808497http://catalogue.bnf.fr/ark:/12148/cb48756491h  a979-10-408-0849-7bRel.d17.90 EUR  a(Abes)296574368#1a9791040808497  a20260407j20260408b  u0frey50      ba0 afre  aFR  aa       000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aUn an ailleursbTexte impriméfMax Ducos  aPariscSarbacane EditionsdDL 2026#0aPariscSarbacane EditionsdDL 2026  a1 vol. (56 p.)cill. en coul.d32 cm x 24 cmf675 g2 aAlbums Sarbacane  aDisponible  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497_1-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497_2-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497_3-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497_4-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497_5-475x500-1.jpg  aAs-tu déjà imaginé t'installer avec tes parents une année entière dans une maison et un pays inconnus ? C'était le rêve du peintre Max Ducos, qui t'emmène, le temps de ce livre, dans les bagages de sa propre famille, au fond d'une vallée secrète à deux heures de New York. Les saisons défilent, la maison se pare pour les fêtes puis se couvre de neige, les filles de Max s'élancent au-dehors, d'élégants petits animaux s'approchent ... Au fil des pages, partage les surprises, les émotions, les jeux, les rencontres, les découvertes - en un mot, la joie ressentie tout au long de cette année exceptionnelle. Une expérience qui changera la vie des deux fillettes. La tienne aussi, peut-être ?  aÀ partir de 3 ans  b9791040808497 0tAlbums Sarbacane  311933986aFamille2rameau  311978431aVoyage2rameau  312011351aDéménagement2rameau  313162676aHabitations2rameau  311956381aSaisons2rameau  311931371aÉtats-Unis2rameau  311938887aLivres illustrés pour enfants2rameau  312042408aOuvrages pour la jeunesse2rameau  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE200c22ORB-Code  aLivres 3 ans et +c22ORB-Label  aJE203c32ORB-Code  aAlbumsc32ORB-Label 1aDucosbMaxf1979-....oISNI00000000131253483150632034070 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260423gAFNOR 0aFRbAbesc20260429gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040808497-475x500-1.jpg  a101940cam# 2200457#i 450 orb9791036356292http://catalogue.bnf.fr/ark:/12148/cb48752597w  a979-10-363-5629-2bRel.d17.90 EUR#1a9791036356292  a20260413j20260415a  u0frey50      ba0 afre  aFR  aa   t   000yy  ar  601aibxxxe  602ctxt2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aIceworldbTexte impriméeCourse contre la glacefAnne RivièregGabriele Barsotti  aMontrouge cedexcBayard jeunessedDL 2026#0aMontrouge cedexcBayard jeunessedDL 2026  a1 vol. (88 p.)cill. en coul.d31 cm x 25 cmf856 g2 aBande d'ados  aDisponible  aAu statioport de Bluetown, Roméo est témoin d'un bug informatique. Il a à peine le temps de comprendre ce qu'il a vu sa navette spatiale est attaquée par un drone ! Roméo s'écrase sur Seiren, une planète déserte et glacée. Il lui reste 17 heures pour trouver de l'aide et comprendre qui est à ses trousses, après quoi sa combinaison thermique n'aura plus de batterie, et il sera victime du froid...  b9791036356292 0tBande d'ados  a741.5v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD100c22ORB-Code  aBD jeunessec22ORB-Label  aBD102c32ORB-Code  aSF - Fantasy - Fantastiquec32ORB-Label 1aRivièrebAnneoISNI00000001192938683162719124690 1aBarsottibGabriele4440 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20260415gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791036356292-475x500-1.jpg  a104160cam# 2200493#i 450 orb9788832914184  a978-88-3291-418-4bRel.d14.90 EUR  a(Abes)268783039#1a9788832914184  a20230214j20230216c  u0frey50      ba0 afre  aIT  aa       000yy  ar  601aibxxxeabbxb2e  601ctxtcsti2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aDino méditationbTexte impriméeA l'écoute et à la découverte de soi-même aux côtés des petits dinosauresfLorena PajalungagAnna Láng  aMilancWhite Star KidsdDL 2023#0aMilancWhite Star KidsdDL 2023  a1 vol. (40 p.)cill. en coul.d25 cm x 20 cmf468 g  aDisponible  aBienvenu à l'école jurassique de pleine conscience de maître Diplo ! Tu vas faire la connaissance de quatre adorables petits dino aux côtés desquels tu apprendras les secrets de la méditation. Rex s'emporte facilement et a vraiment du mal à garder son calme. Raptor ne tient pas en place. Tout le contraire de Trixie, un peu trop calme et toujours à l'écart. Dactyla, quant à elle, craint toujours de ne pas être à la hauteur et de déplaire aux autres. Pas facile quand on est petits d'affronter les tracas de la vie de tous les jours, les émotions qui nous submergent quand on manque d'assurance, qu'on est en proie à la colère ou qu'on déborde d'énergie. Voici une série de courtes séances de méditation qui permettront aux enfants de porter leur attention sur le moment présent, d'acquérir le contrôle de soi, la capacité de gérer ses sentiments négatifs, d'apprendre la résilience, l'empathie et la compassion. Avec en prime, de drôles de petits dino, les meilleurs copains du monde ! Une belle invitation aux illustrations douces et tendres, pour une initiation à la pleine conscience.  aÀ partir de 6 ans  aIl y a trente ans, LORENA PAJALUNGA s'est vu confier, par son maître Swami Satyananda de la Bihar School of Yoga de Munger, en Inde, la mission d'apprendre le yoga aux enfants. Elle a ainsi fondé l'association italienne de yoga pour enfants (AIYB), et par la suite est devenue coordinatrice d'un master de yoga pour enfants et adolescents en sciences de l'éducation et de la formation de l'université Suor Orsola Benincasa de Naples. Diplomée en sciences de l'éducation et de la formation, elle dirige l'atelier GiocaYoga(r) auprès du département de Pédagogie du corps de l'université Bicocca de Milan. Au cours des dernières années, elle a supervisé plusieurs ouvrages consacrés au yoga pour les éditions White Star Kids. Graphiste et illustratrice d'origine hongroise, ANNA LANG vit à Milan. Elle a suivi des études de graphisme à l'université des beaux-arts de Budapest (2006-2011) puis a travaillé pendant trois ans dans une agence de publicité. Elle a remporté le prix de la biennale hongroise de graphisme de la ville de Békéscsaba avec sa Shakespeare Poster Series. Actuellement, elle travaille à Milan pour l'agence 6. 14 Creative Licensing. Au cours des dernières années elle a illustré différents ouvrages publiés aux éditions White Star Kids.  b9788832914184  311932470aMéditation311975674xÉtude et enseignement2rameau  311932470aMéditation316658789xChez l'enfant2rameau  313611129aLivres documentaires pour la jeunesse2rameau  a158.120 83v23  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE700c22ORB-Code  aDocumentairesc22ORB-Label  aJE713c32ORB-Code  aMon corps et moi dès 6 ansc32ORB-Label 1aPajalungabLorena4070 1aLángbAnnaoISNI00000004803280483171651114440 0aFRbbase-orbc20260807gAFNOR 0aFRbAbesc20230329gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9788832914184-475x500-1.jpg  a102235cam# 2200541#i 450 orb9791041111732http://catalogue.bnf.fr/ark:/12148/cb476672270  a979-10-411-1173-2bBr.d7.95 EUR  a(Abes)283651660#1a9791041111732  a20250303j20250305m  u0frey50      ba1 afrecjpn  aFR  aa   t   000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aLes Promeneuses de l'apocalypsebTexte impriméfSakae Saitogtraduit du japonais par Laurent Lemercier  aCharnay-lès-MâconcBamboo EditionsdDL 2025#0aCharnay-lès-MâconcBamboo EditionsdDL 2025  a1 vol. (176 p.)cill.d18 cm x 12 cmf186 g2 aDoki Doki. Seinen  aDisponible  aNos deux motardes décident de faire une halte à l'abri qui a été le point de départ de leur périple. Une occasion pour elles de se remémorer le bon vieux temps. Elles reprendront ensuite la route vers la région du Tôhoku, au nord de l'île principale. Entre excavation de fossiles à Iwaki et pêche miraculeuse dans le lac Inawashiro, leur trépidant voyage les conduira jusqu'à Nagaoka, dans le département de Niigata.  b9791041111732 0tDoki Doki. Seinen 0tShumatsu Touring 0tLes Promeneuses de l'apocalypsev6  312464282aMangas2rameau  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-05c42ORB-Code  aSeinen (homme)c42ORB-Label 1aSaitobSakae4070 1aLemercierbLaurent4730 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20250224gAFNOR 0aFRbAbesc20260214gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791041111732-475x500-1.jpg  a102268cam# 2200469#i 450 orb9791039575119  a979-10-395-7511-9bBr.d16.95 EUR#1a9791039575119  a20260424j20260430d  u0frey50      ba1 afreceng  aFR  ay###    000ay  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aLa clé de DedaleumbTexte impriméfJordan Leesgtraduit de l'anglais par Juliette Lê  aPariscEditions AuzoudDL 2026#0aPariscEditions AuzoudDL 2026  a1 vol. (374 p.)d21 cm x 15 cmf634 g  aDisponible  aLe grand final d'une saga époustouflante ! Le terrible magus Manfred Tarr est à la recherche d'une clé. Une clé perdue depuis des années, qui détient le pouvoir de libérer les ténèbres dans le labyrinthe... Pour sauver Dedaleum, Benjamiah et Elizabella n'ont qu'une seule solution : accomplir les épreuves des Trois Soeurs et retrouver la clé avant. Ils se lancent dans un dangereux voyage jusqu'à la Forêt Tordue, qui abrite les créatures les plus incroyables, et jusqu'à l'ultime bataille. Une guerre dont ils ne sortiront pas indemnes.  aÀ partir de 12 ans  b9791039575119 0tLes Whisperwicks Tome 3 : La clé de Dedaleum. Edition collectoruhttps://www.base-orb.fr/product/9791039575126/show/y9791039575126 0tLes Whisperwicks Tome 3 : La clé de Dedaleumuhttps://www.base-orb.fr/product/9791039585163/show/y9791039585163 0tThe Whisperwicks: The Vanished Key 0tLes Whisperwicksv3  a804v23  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE500c22ORB-Code  aLecture 12 ans et +c22ORB-Label  aJE507c32ORB-Code  aMondes fantastiquesc32ORB-Label 1aLeesbJordan4070 1aLêbJulietteoISNI00000000713370903161318404730 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791039575119-475x500-1.jpg  a102945cam# 2200481#i 450 orb9791040123378http://catalogue.bnf.fr/ark:/12148/cb48597598x  a979-10-401-2337-8bRel.d13.90 EUR#1a9791040123378  a20250905j20250905b  u0frey50      ba0 afre  aFR  aa       000yy  ar  601aibxxxeabbxb2e  602ctxtcsti2rdacontent  601an  602cn2rdamedia  anga2RDAfrCarrier1 aBienvenue au Coccinelle hôtelbTexte impriméfRa Kyoung HangMouun  aPariscLa Martinière jeunessedDL 2025#0aPariscLa Martinière jeunessedDL 2025  a1 vol. (48 p.)cill. en coul.d23 cm x 21 cmf330 g  aDisponible  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040123378_1-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040123378_2-475x500-1.jpg  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040123378_3-475x500-1.jpg  aDans un sous-bois en forêt, Dada, la grand-mère, MooMoo, son petit-fils, et leur famille coccinelle s'apprêtent à recevoir en leur hôtel quelques représentants d'espèces qui hibernent?: la triche fasciée, la capricorne et la mante religieuse, championne du concours de bras de fer du village des herbes. Mais quelle déception pour MooMoo quand il découvre que ce sont les larves et les nymphes qui débarquent... Dada le console par un «?Patience mon chéri, laisse l'hiver faire son travail et tu verras?». Un album documentaire qui réussit le pari de la fiction et de la documentation grâce à une illustration à la fois précise et fantaisiste. Attention, le jeune lecteur, à la vue de la chambre Hêtre ou Érable, pourrait bien avoir envie lui aussi d'hiberner?!d20260301  aDans la forêt, l'automne touche à sa fin. Le petit MooMoo trépigne d'excitation à l'idée d'accueillir les premiers invités du Coccinelle Hôtel. Il ne se doute pas encore des surprises que la nature lui réserve... A la fin de l'album, retrouve des pages documentaires et une activité pour fabriquer ton hôtel à insectes !  aÀ partir de 3 ans  b9791040123378  aJEc12ORB-Code  aJeunessec12ORB-Label  aJE200c22ORB-Code  aLivres 3 ans et +c22ORB-Label  aJE203c32ORB-Code  aAlbumsc32ORB-Label 1aHanbRa Kyoung3182476664070 1aMouun3182476734440 0aFRbbase-orbc20260807gAFNOR 0aFRbFR-751131015c20250909gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791040123378-475x500-1.jpg  a102904cam# 2200505#i 450 orb9791042021825  a979-10-420-2182-5bBr.d7.95 EUR#1a9791042021825  a20260703j20260702a  u0frey50      ba1 afrecjpn  aFR  aa   t   000yy  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aMoi, quand je me réincarne en SlimebTexte impriméfTaiki KawakamigFusegMitz Vahgtraduit du japonais par Erica Moriya  aPariscKurokawadDL 2026#0aPariscKurokawadDL 2026  a1 vol. (192 p.)cill.d18 cm x 13 cmf178 g  aDisponible  aComment un slime devient le seigneur du royaume ! Limule affronte Yûki, manipulé par le pouvoir de Mariabell, mais comprend qu'il n'arrivera pas à le libérer de son emprise. Alors que le duel bat son plein, ils sont interrompus de façon plutôt inattendue. Millim est partie rejoindre le dragon du chaos, et pendant ce temps, Mariabell s'est volatilisée... La situation évolue rapidement sur plusieurs fronts à la fois. Comment Limule fera-t-il face à cette crise ?  aTaiki Kawakami Résidant à Saitama, Taiki Kawakami est un mangaka japonais. Il est principalement connu pour avoir réalisé les adaptations en mangas des lights novels Alderamin on the Sky (publiée dans le magazine Dengeki Maoh ) et Moi, quand je me réincarne en Slime (publiée dans le magazine Shônen Sirius ). FUSE Scénariste de la light novel Moi, quand je me réincarne en Slime ( Tensei Shitara Slime Datta Ken ), tout d'abord diffusée sur le web via la plate-forme Shôsetsuka ni narô, FUSE supervise à présent le scénario du manga issu de cette série de romans. MITZ VAH MITZ VAH est le chara-designer du manga Moi, quand je me réincarne en Slime .  b9791042021825 0tMoi, quand je me réincarne en Slime Tome 30uhttps://www.base-orb.fr/product/9791042022471/show/y9791042022471 0tTensei shitara Slime datta Ken 0tMoi, quand je me réincarne en Slimev30  a741.552v23  aBDc12ORB-Code  aBandes dessinées Humourc12ORB-Label  aBD500c22ORB-Code  aMangasc22ORB-Label  aBD501c32ORB-Code  aMangasc32ORB-Label  aBD501-04c42ORB-Code  aShonen (garçon)c42ORB-Label 1aKawakamibTaikioISNI000000038677800X3171550584070 1aFuseoISNI000000044238601X3177112304100 1aMitz Vah4440 1aMoriyabErica4730 0aFRbbase-orbc20260807gAFNOR  uhttps://products-images.di-static.com/image/orb-81b4b7e803cf8a9685feb3d180ed455a/9791042021825-475x500-1.jpg  a101672cam# 22005052i 450 orb9791043302800  a979-10-433-0280-0bBr.d8.50 EUR#1a9791043302800  aj20260826a  u0frey50      ba1 afrecjpn  aFR  aa   t   000yy  ar  601aibxxxe  601ctxt2rdacontent  601an  601cn2rdamedia  anga2RDAfrCarrier1 aTokyo BabylonbTexte impriméfClampgtraduit du japonais pa